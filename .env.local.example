# ---- Supabase ----
# Project settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Server-only. Project settings → API → service_role. NEVER expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Site ----
# Used to build OAuth redirect URLs. In prod set to your deployed URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Paystack ----
# Dashboard → Settings → API Keys & Webhooks. Use TEST keys while developing.
# If unset, the payment step runs in demo mode (no real charge).
PAYSTACK_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxx

# ---- Later (stubs for now) ----
# RESEND_API_KEY=
